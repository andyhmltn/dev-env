#!/usr/bin/env zsh

SKETCHYBAR_CONFIG="$HOME/.config/sketchybar"

WIDTH=$(/usr/bin/swift - <<'SWIFT' 2>/dev/null
import AppKit
if let s = NSScreen.main { print(Int(s.frame.width)) }
SWIFT
)

if [[ -n "$WIDTH" && "$WIDTH" -ge 3440 ]]; then
    source "$SKETCHYBAR_CONFIG/sketchybarrc-desktop"
else
    source "$SKETCHYBAR_CONFIG/sketchybarrc-laptop"
fi

sketchybar --add item display_watcher left \
    --set display_watcher drawing=off \
    script="sketchybar --reload" \
    --subscribe display_watcher display_change
