#!/usr/bin/env zsh

# Install with: brew install --cask font-blex-mono-nerd-font
FONT_FACE="BlexMono Nerd Font"

# Register the installed face with SketchyBar before creating any text. This
# also makes a font installed after the service started available on reload.
FONT_FILE="$HOME/Library/Fonts/BlexMonoNerdFont-Bold.ttf"
if [[ -f "$FONT_FILE" ]]; then
    sketchybar --load-font "$FONT_FILE"
fi

PLUGIN_DIR="$HOME/.config/sketchybar/plugins-laptop"
PLUGIN_SHARED_DIR="$HOME/.config/sketchybar/plugins"

# Palette: bolder, darker
BAR_BG=0x00000000
ITEM_BG=0xff1e1e2e
TEXT=0xffe4e4ef
ACCENT_CPU=0xfff38ba8
ACCENT_MEM=0xfffab387
ACCENT_NET=0xff94e2d5
ACCENT_MEET=0xfff9e2af
ACCENT_POMO=0xffeba0ac
ACCENT_WEATHER=0xff89b4fa
ACCENT_MOON=0xffb4befe
ACCENT_CLOCK=0xffcba6f7
ACCENT_BAT=0xffa6e3a1
ACCENT_VOL=0xff89dceb
ACCENT_WORK=0xff94e2d5
ACCENT_FREE=0xffa6e3a1

sketchybar --bar \
    height=40 \
    color=$BAR_BG \
    margin=0 \
    sticky=on \
    topmost=on \
    padding_left=20 \
    padding_right=20 \
    display=main

sketchybar --default \
    background.color=$ITEM_BG \
    background.corner_radius=6 \
    background.padding_right=5 \
    background.height=30 \
    icon.font="$FONT_FACE:Bold:16.0" \
    icon.padding_left=8 \
    icon.padding_right=5 \
    label.font="$FONT_FACE:Bold:13.0" \
    label.color=$TEXT \
    label.y_offset=0 \
    label.padding_left=0 \
    label.padding_right=8

##### LEFT #####

sketchybar --add item front_app left \
    --set front_app \
    icon.drawing=off \
    label.font="$FONT_FACE:Bold:14.0" \
    label.max_chars=18 \
    label.color=$TEXT \
    label.padding_left=10 \
    label.padding_right=10 \
    script="$PLUGIN_SHARED_DIR/front_app.sh" \
    --subscribe front_app front_app_switched

sketchybar --add item next_meeting left \
    --set next_meeting \
    icon= \
    icon.color=$ACCENT_MEET \
    label.color=$TEXT \
    label.max_chars=12 \
    scroll_texts=on \
    drawing=off \
    update_freq=60 \
    script="$PLUGIN_SHARED_DIR/next_meeting.sh"

sketchybar --add item free_block left \
    --set free_block \
    icon=󰃭 \
    icon.color=$ACCENT_FREE \
    label.color=$TEXT \
    drawing=off \
    update_freq=120 \
    script="$PLUGIN_SHARED_DIR/free_block.sh"

sketchybar --add item workday left \
    --set workday \
    icon=󰅐 \
    icon.color=$ACCENT_WORK \
    label.color=$TEXT \
    drawing=off \
    update_freq=60 \
    script="$PLUGIN_SHARED_DIR/workday.sh"


##### RIGHT (reverse order of visual placement) #####


sketchybar --add item clock right \
    --set clock \
    icon=󰃰 \
    icon.color=$ACCENT_CLOCK \
    update_freq=10 \
    script="$PLUGIN_SHARED_DIR/clock.sh"

sketchybar --add item battery right \
    --set battery \
    icon.color=$ACCENT_BAT \
    label.align=center \
    update_freq=20 \
    script="$PLUGIN_DIR/battery.sh"


sketchybar --add item weather right \
    --set weather \
    icon=󰖙 \
    icon.color=$ACCENT_WEATHER \
    update_freq=1800 \
    script="$PLUGIN_SHARED_DIR/weather.sh" \
    --subscribe weather system_woke




##### Finalizing Setup #####
sketchybar --update
sketchybar --trigger space_change
