#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        td_colon: td_colon {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp COLON>, <&kp N1>;
        };

        lt_enter: lt_enter {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };

        lt_homerow: lt_homerow {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            bindings = <&mo>, <&kp>;
        };

        lt_num: lt_num {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            bindings = <&mo>, <&kp>;
        };

    };

    combos {
        compatible = "zmk,combos";

        combo_boot_left {
            timeout-ms = <50>;
            key-positions = <0 5>;
            bindings = <&bootloader>;
            layers = <0>;
        };

        combo_boot_right {
            timeout-ms = <50>;
            key-positions = <6 11>;
            bindings = <&bootloader>;
            layers = <0>;
        };
    };

    macros {
        m_tmux_w: m_tmux_w {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>, <&kp LS(W)>;
        };

        m_tmux_g: m_tmux_g {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>, <&kp G>;
        };

        m_sp_gg: m_sp_gg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp SPACE>, <&kp G>, <&kp G>;
        };

        m_q_bang_cr: m_q_bang_cr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp COLON>, <&kp Q>, <&kp EXCL>, <&kp ENTER>;
        };

        m_tmux_h: m_tmux_h {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>, <&kp H>;
        };

        m_sp_dash: m_sp_dash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp SPACE>, <&kp MINUS>;
        };

        m_tmux_z: m_tmux_z {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>, <&kp Z>;
        };

        m_tmux_c: m_tmux_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>, <&kp C>;
        };

        m_jump_prev_diag: m_jump_prev_diag {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LBKT>, <&kp G>;
        };

        m_jump_next_diag: m_jump_next_diag {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp RBKT>, <&kp G>;
        };

        m_tick_A: m_tick_A {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp GRAVE>, <&kp LS(A)>;
        };

        m_tick_B: m_tick_B {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp GRAVE>, <&kp LS(B)>;
        };

        m_tick_C: m_tick_C {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp GRAVE>, <&kp LS(C)>;
        };

        m_tmux_x: m_tmux_x {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>, <&kp X>;
        };

        m_tmux_copy: m_tmux_copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>, <&kp LBKT>;
        };

        m_tmux_l: m_tmux_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>, <&kp L>;
        };

        m_tmux_split_h: m_tmux_split_h {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>, <&kp DQT>;
        };

        m_tmux_split_v: m_tmux_split_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>, <&kp PRCNT>;
        };

        m_sp_gtl: m_sp_gtl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp SPACE>, <&kp MINUS>, <&kp G>, <&kp T>, <&kp L>;
        };

        m_sp_btl: m_sp_btl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp SPACE>, <&kp MINUS>, <&kp B>, <&kp T>, <&kp L>;
        };

        m_slash_slash: m_slash_slash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp FSLH>, <&kp FSLH>;
        };

        m_fat_arrow: m_fat_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp EQUAL>, <&kp GT>;
        };

        m_dotdot_slash: m_dotdot_slash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp DOT>, <&kp DOT>, <&kp FSLH>;
        };

        m_55_star: m_55_star {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp N5>, <&kp N5>, <&kp KP_MULTIPLY>;
        };

        m_col_plus_1_col: m_col_plus_1_col {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp COLON>, <&kp KP_PLUS>, <&kp N1>, <&kp COLON>;
        };

        m_tmux_a: m_tmux_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>, <&kp A>;
        };

        m_tmux_0: m_tmux_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>, <&kp N0>;
        };

        m_tmux_1: m_tmux_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>, <&kp N1>;
        };

        m_tmux_2: m_tmux_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>, <&kp N2>;
        };

        m_tmux_3: m_tmux_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>, <&kp N3>;
        };

        m_tmux_4: m_tmux_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>, <&kp N4>;
        };

        m_tmux_5: m_tmux_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>, <&kp N5>;
        };

        m_tmux_6: m_tmux_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>, <&kp N6>;
        };

        m_tmux_7: m_tmux_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>, <&kp N7>;
        };

        m_tmux_8: m_tmux_8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>, <&kp N8>;
        };

        m_tmux_9: m_tmux_9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(B)>, <&kp N9>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            bindings = <
&mt LALT TAB  &kp Q  &kp W  &kp E  &kp R  &kp T           &kp Y  &kp U  &kp I            &kp O           &kp P      &kp UNDER
&kp ESC     &kp A  &kp S  &lt_homerow 7 D  &lt_num 3 F      &kp G           &kp H  &kp J  &kp K            &kp L           &kp DOT    &kp SQT
&caps_word  &kp Z  &kp X  &kp C  &kp V  &kp B           &kp N  &kp M  &mt LCTRL COMMA  &mt LGUI EXCL   &kp MINUS  &td_colon
                        &kp LSHFT  &kp BSPC  &mo 1         &lt_enter 2 RET  &kp SPACE  &kp LGUI
            >;
        };

        fn_layer {
            display-name = "FN";
            bindings = <
&kp LA(LG(J))  &m_tmux_w   &m_tmux_g    &m_sp_gg    &kp LG(C)          &kp LG(V)           &m_tmux_x  &m_tmux_copy  &m_tmux_l        &kp LG(LS(I))        &kp LG(LS(L))          &kp LA(LG(LS(O)))
&m_q_bang_cr   &m_tmux_h   &kp LC(S)    &m_sp_dash  &kp LG(LS(K))      &mo 6               &kp LEFT   &kp DOWN      &kp UP           &kp RIGHT        &kp LA(LG(RS(SPACE)))  &kp LA(LG(LS(FSLH)))
&kp LA(LG(H))  &m_tmux_z   &kp LG(R)    &m_tmux_c   &m_jump_prev_diag  &m_jump_next_diag   &kp LC(B)  &kp LC(C)     &m_tmux_split_h  &m_tmux_split_v  &m_sp_gtl              &m_sp_btl
                        &trans  &trans  &trans                                             &mo 4  &m_tmux_a  &trans
            >;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
&trans       &kp PRCNT  &kp PLUS      &kp CARET        &kp STAR    &trans        &kp LT     &kp GT     &kp LBRC  &kp RBRC  &m_55_star         &trans
&kp LC(RET)  &kp BSLH   &kp SEMI      &m_slash_slash   &kp QMARK   &kp DLLR      &kp FSLH   &kp LC(R)  &kp LPAR  &kp RPAR  &kp AT             &trans
&trans       &kp AMPS   &m_fat_arrow  &m_dotdot_slash  &kp PIPE    &kp EQUAL     &kp GRAVE  &kp DQT    &kp LBKT  &kp RBKT  &m_col_plus_1_col  &kp LG(TAB)
                        &trans  &trans  &mo 4                                    &trans  &trans  &trans
            >;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &kp LC(LA(LS(T)))          &kp N0    &kp N7  &kp N8  &kp N9  &kp EQUAL  &trans
&trans  &trans  &trans  &trans  &trans  &mo 5           &kp HOME  &kp N4  &kp N5  &kp N6  &kp PLUS   &to 0
&trans  &trans  &trans  &trans  &trans  &none           &kp END   &kp N1  &kp N2  &kp N3  &kp MINUS  &to 0
                        &trans  &trans  &trans          &trans  &kp N0  &trans
            >;
        };

        scrn_layer {
            display-name = "SCRN";
            bindings = <
&trans  &trans  &trans  &trans  &kp LG(LA(LEFT))   &kp LG(LA(RIGHT))         &kp LG(SPACE)       &kp LA(LG(LS(N8)))  &trans              &trans              &trans  &trans
&trans  &kp LA(LC(N0))  &kp LA(LC(N1))  &kp LA(LC(N2))  &to 7   &trans          &kp LG(N4)          &kp LA(LG(LC(N2)))  &kp LA(LG(LC(N3)))  &kp LA(LG(LC(N4)))  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &kp LA(LG(LS(N5)))  &kp LA(LG(LS(N6)))  &kp LA(LG(LS(N7)))  &trans              &trans  &trans
                        &trans  &trans  &trans          &trans  &trans  &trans
            >;
        };

        move_layer {
            display-name = "MOVE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &kp LA(LS(N7))  &kp LA(LS(N8))  &kp LA(LS(N9))  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &kp LA(LS(N4))  &kp LA(LS(N5))  &kp LA(LS(N6))  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &kp LA(LS(N1))  &kp LA(LS(N2))  &kp LA(LS(N3))  &trans  &trans
                        &trans  &trans  &trans          &trans  &trans  &trans
            >;
        };

        bt_layer {
            display-name = "BT";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans          &out OUT_BLE    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans          &bt BT_CLR      &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_PRV    &bt BT_NXT  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &bt BT_CLR_ALL  &trans        &trans        &trans        &trans      &trans
                        &trans  &trans  &trans                                   &trans  &trans  &trans
            >;
        };

        tmux_layer {
            display-name = "TMUX";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans          &m_tmux_0  &m_tmux_7  &m_tmux_8  &m_tmux_9  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans     &m_tmux_4  &m_tmux_5  &m_tmux_6  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans     &m_tmux_1  &m_tmux_2  &m_tmux_3  &trans  &trans
                        &trans  &trans  &trans          &trans  &m_tmux_0  &trans
            >;
        };

        runescape_layer {
            display-name = "RS";
            bindings = <
&kp F7  &to 0   &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &kp F8
&to 0   &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &kp F1
&kp F9  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &kp F5
                        &trans  &kp F2  &kp F10          &kp F1  &kp F3  &kp F5
            >;
        };
    };
};
